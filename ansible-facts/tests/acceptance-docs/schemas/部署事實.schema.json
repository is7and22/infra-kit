{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "部署事實.schema.json",
  "title": "部署事實",
  "description": "項目的部署工具輸出、產生驗收文件軟體表與連線表用的事實。欄位說明見 docs/部署事實格式.md；本檔手寫，是格式的唯一來源",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "generated_at", "hosts", "groups", "components", "links", "problems"],
  "properties": {
    "format_version": {"const": 1},
    "generated_at": {"$ref": "#/$defs/time"},
    "hosts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "ip"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "ip": {"type": "string", "format": "ipv4", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}$"}
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "hosts"],
        "properties": {
          "name": {"$ref": "#/$defs/name"},
          "label": {"$ref": "#/$defs/text"},
          "hosts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/name"}}
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "in_table"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "name": {"$ref": "#/$defs/text"},
          "plan_name": {"$ref": "#/$defs/text"},
          "type": {"enum": ["application", "container", "library", "operating-system", "platform", "framework"]},
          "in_table": {"type": "boolean"},
          "versions": {"$ref": "#/$defs/versions"},
          "instances": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["host", "check"],
              "properties": {
                "host": {"$ref": "#/$defs/name"},
                "versions": {"$ref": "#/$defs/versions"},
                "check": {"$ref": "#/$defs/check"},
                "problem": {"$ref": "#/$defs/text"}
              }
            }
          }
        }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "ports", "protocol", "purpose", "firewalled", "checks"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "from": {
            "type": "array",
            "minItems": 1,
            "items": {"oneOf": [{"$ref": "#/$defs/group_end"}, {"$ref": "#/$defs/any_end"}]}
          },
          "to": {"oneOf": [{"$ref": "#/$defs/group_end"}, {"$ref": "#/$defs/self_end"}]},
          "ports": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[0-9]{1,5}$"}},
          "protocol": {"enum": ["tcp", "udp"]},
          "purpose": {"$ref": "#/$defs/text"},
          "firewalled": {"type": "boolean"},
          "checks": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["service", "instances"],
              "properties": {
                "service": {"$ref": "#/$defs/text"},
                "note": {"type": "string"},
                "instances": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["host", "check"],
                    "properties": {
                      "host": {"$ref": "#/$defs/name"},
                      "check": {"$ref": "#/$defs/check"},
                      "problem": {"$ref": "#/$defs/text"}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "host", "command", "output", "time"],
        "properties": {
          "id": {"$ref": "#/$defs/name"},
          "title": {"$ref": "#/$defs/text"},
          "host": {"$ref": "#/$defs/name"},
          "command": {"$ref": "#/$defs/text"},
          "output": {"type": "string"},
          "time": {"$ref": "#/$defs/time"}
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["message"],
        "properties": {"message": {"$ref": "#/$defs/text"}}
      }
    }
  },
  "$defs": {
    "name": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "text": {"type": "string", "minLength": 1},
    "time": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["version"],
        "properties": {
          "version": {"$ref": "#/$defs/text"},
          "label": {"$ref": "#/$defs/text"},
          "full": {"$ref": "#/$defs/text"},
          "lock": {"$ref": "#/$defs/name"}
        }
      }
    },
    "check": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["result", "time"],
          "properties": {
            "result": {"enum": ["pass", "fail"]},
            "time": {"$ref": "#/$defs/time"},
            "service": {"type": "string"},
            "method": {"$ref": "#/$defs/text"}
          }
        }
      ]
    },
    "group_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group"],
      "properties": {"group": {"$ref": "#/$defs/name"}}
    },
    "any_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["any", "label"],
      "properties": {"any": {"const": true}, "label": {"$ref": "#/$defs/text"}}
    },
    "self_end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["self"],
      "properties": {"self": {"const": true}}
    }
  }
}
